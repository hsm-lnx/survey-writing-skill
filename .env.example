# 字段清单。脚本不自动读取本文件，请把值设成系统环境变量。
#
# 最省事：不要手工填这个文件，运行交互式配置——
#   python .claude/doctor.py --configure
# 它会验证并写入你的用户级环境变量。详见 KEY_SETUP.md。
#
# 如果你确实要手工设：Windows 用 [Environment]::SetEnvironmentVariable(...,"User")，
# macOS/Linux 写进 ~/.zshrc 或 ~/.bashrc。.env 已被 .gitignore 排除。

# AMiner 检索层（aminer_search.py 需要）
# 从你自己 aminer.cn 账号的浏览器会话取 Bearer token
AMINER_API_KEY=

# Zotero 直写通道（zotero_client.py 需要）
# userID 在 https://www.zotero.org/settings/keys 页面顶部
ZOTERO_USER_ID=
# 在同一个页面 Create new private key，勾选 library Read/Write
ZOTERO_API_KEY=

# 可选：接口原始返回落盘目录，默认 ./reports/_raw
ZOTERO_RAW_DIR=

# 可选：查全复核（skills/survey-ops/scripts/search/）
# 不给也能匿名请求；大批量深翻时设 key 提高额度
OPENALEX_API_KEY=
# 礼貌池标识：填你的联系邮箱即可，便于服务方识别流量
OPENALEX_MAILTO=
CROSSREF_MAILTO=
