# 复制为 .env 后填自己的值；.env 已被 .gitignore 排除。
# 脚本不自动读取本文件，请把值设成系统环境变量。详见 KEY_SETUP.md。

# AMiner 检索层（aminer_search.py 需要）
# 从你自己 aminer.cn 账号的浏览器会话取 Bearer token
AMINER_API_KEY=

# Zotero 直写通道（zotero_client.py 需要）
# userID 在 https://www.zotero.org/settings/keys 页面顶部
ZOTERO_USER_ID=
# 在同一个页面 Create new private key，勾选 library Read/Write
ZOTERO_API_KEY=

# 可选：接口原始返回落盘目录，默认 ./reports/_raw
ZOTERO_RAW_DIR=
